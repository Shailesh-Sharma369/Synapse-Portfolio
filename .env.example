# =============================================================================
# Synapse Portfolio — Month-End Close Platform
# Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env` to git — it holds API keys and secrets.
# The `.env` file is already in `.gitignore`.
# =============================================================================

# LOCAL-FIRST / ZERO-TRUST
# All ports bind to 127.0.0.1 only. Postgres and Redis are not exposed.
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=month_end_close
DATABASE_URL=postgresql+psycopg2://admin:changeme_local_only@db:5432/month_end_close
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
AGNO_TELEMETRY=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=1
HF_HUB_DISABLE_TELEMETRY=1
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
PRIVACY_MASKING_ENABLED=1
PRIVACY_MAP_TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# LLM PROVIDER — Google Gemini
# -----------------------------------------------------------------------------
# Required. Get a free key at https://aistudio.google.com/app/apikey
# Free tier allows ~15 requests/minute — the orchestrator paces calls to
# stay within this limit (see app/agents/orchestrator.py CHORD_STAGGER_SECONDS).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini rate limit — max LLM calls per 60 seconds ACROSS ALL workers.
# Free tier allows 15 RPM; 12 gives headroom for notifications.
GEMINI_MAX_RPM=12
GEMINI_CALLS_PER_AGENT=4

# Pipeline LLM toggle:
#   0 → pipeline agents run deterministic-only (fast, no quota burn)
#   1 → full ReAct reasoning (needs quota, 503-prone on free tier)
PIPELINE_USE_LLM=0


# ---- LLM provider -----------------------------------------------------------
# "gemini" (default, tested) or "claude" (optional, requires ANTHROPIC_API_KEY)
LLM_PROVIDER=gemini
LLM_MODEL_ID=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=


# ---- Pacing / rate limiting -------------------------------------------------
# Delay between dispatching each company's Phase-1 chord (seconds).
# Free tier: 15-20. Paid tier: 0-2.
CHORD_STAGGER_SECONDS=15

# Delay inside each agent task before the LLM call (seconds).
# Usually 0 — the Redis-backed rate limiter handles the RPM cap.
AGENT_STAGGER_SECONDS=0


# -----------------------------------------------------------------------------
# EMAIL DELIVERY — Resend
# -----------------------------------------------------------------------------
# Optional. If RESEND_API_KEY is empty, the reporting agent runs in MOCK MODE
# and prints the rendered HTML email to stdout (visible in `docker compose logs`).
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Recipient address (where close emails land). Any valid email.
TO_EMAIL=cfo@synapse.example

# Sender address. On the Resend free tier without a verified domain,
# use `onboarding@resend.dev`.
FROM_EMAIL=onboarding@resend.dev


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
# Docker Compose uses these to create the container.
# NOTE: `db` is the Docker service name, not `localhost`.
# SQLAlchemy connection string is defined in the local-first block above.


# -----------------------------------------------------------------------------
# CACHE & BROKER — Redis
# -----------------------------------------------------------------------------
# NOTE: `redis` is the Docker service name, not `localhost`.
# The three different DB numbers keep concerns isolated:
#   /0 — application state (rate limiter, workflow state, run tracking)
#   /1 — Celery broker
#   /2 — Celery result backend


# -----------------------------------------------------------------------------
# AUTONOMY TOGGLES
# -----------------------------------------------------------------------------
# Autonomy toggle:
#   0 = manual close trigger only (default; for testing/demos)
#   1 = Beat fires a daily 9:00 AM close + formal month-end close on the 1st
ENABLE_AUTONOMOUS_SCHEDULE=0

# Celery Beat master switch.
#   0 = Beat is silent; trigger runs manually (default; best for demos/tests)
#   1 = Beat fires scheduled notification + close tasks
BEAT_ENABLED=0


# -----------------------------------------------------------------------------
# OPTIONAL — Demo / debug
# -----------------------------------------------------------------------------
# Comma-separated subset of company IDs to run (empty = all companies).
# Example: CLOSE_COMPANIES=nexacloud_saas,titanmfg_inc
CLOSE_COMPANIES=

# 1 = verbose Agno ReAct traces in worker logs.
AGENT_DEBUG=0