# =============================================================================
# Apex Capital — Month-End Close Platform
# Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env` to git — it holds API keys and secrets.
# The `.env` file is already in `.gitignore`.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM PROVIDER — Google Gemini
# -----------------------------------------------------------------------------
# Required. Get a free key at https://aistudio.google.com/app/apikey
# Free tier allows ~15 requests/minute — the orchestrator paces calls to
# stay within this limit (see app/agents/orchestrator.py CHORD_STAGGER_SECONDS).
GEMINI_API_KEY=your_gemini_api_key_here


# -----------------------------------------------------------------------------
# EMAIL DELIVERY — Resend
# -----------------------------------------------------------------------------
# Optional. If RESEND_API_KEY is empty, the reporting agent runs in MOCK MODE
# and prints the rendered HTML email to stdout (visible in `docker compose logs`).
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Recipient address (where close emails land). Any valid email.
TO_EMAIL=cfo@apex.example

# Sender address. On the Resend free tier without a verified domain,
# use `onboarding@resend.dev`.
FROM_EMAIL=onboarding@resend.dev


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
# Docker Compose uses these to create the container.
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_dev_password
POSTGRES_DB=apex_close

# SQLAlchemy connection string. Must match the POSTGRES_* values above.
# NOTE: `postgres` is the Docker service name, not `localhost`.
DATABASE_URL=postgresql+psycopg2://apex:apex_dev_password@postgres:5432/apex_close


# -----------------------------------------------------------------------------
# CACHE & BROKER — Redis
# -----------------------------------------------------------------------------
# NOTE: `redis` is the Docker service name, not `localhost`.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1